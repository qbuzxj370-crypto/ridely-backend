<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 3.5.14 (Stable, Java 25 ready since 3.5.5) + 안정성 우선 결정 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <!-- ===== 프로젝트 식별 (팀 조율 후 확정) ===== -->
    <groupId>kr.ridely</groupId>
    <artifactId>ridely</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Ridely</name>
    <description>흩어진 자전거 인프라를 활용해 라이딩을 키우는 AI 트레이너</description>

    <properties>
        <!-- Java 25 LTS (Spring Boot 3.5.5+ Java 25 ready, 학과 수업 일치) -->
        <java.version>25</java.version>

        <!-- ===== AI 버전 관리 =====
             Spring AI 버전 전략 (팀 결정: 안정성 우선):
               - 채택:      1.1.6 Stable (Spring Boot 3.x 기반)
               - 미채택:    2.0.0-M6 (Milestone, API 변경 가능성)
               - 미채택:    2.0.0 GA (2026.06.04 예정, Spring Boot 4 필수)

             LLM Starter 선택:
               - 채택: spring-ai-starter-model-google-genai
                 · Gemini Developer API (개발) + Vertex AI (운영) 모두 지원
                 · application.yml 프로파일만 전환하면 됨
               - 대안: spring-ai-starter-model-vertex-ai-gemini
                 · 1.x에선 정상 사용 가능, 단 GCP 인증 필수
                 · 1.x Google Gen AI에 이슈 발견 시 즉시 전환 가능
        -->
        <spring-ai.version>1.1.6</spring-ai.version>
        <pgvector.version>0.1.6</pgvector.version>
        <jts.version>1.20.0</jts.version>
        <postgis-jdbc.version>2024.1.0</postgis-jdbc.version>
        <!-- 이행적 종속성 CVE 대응 (testcontainers가 끌어오는 취약 버전 override)
             commons-compress: CVE-2024-25710(8.1)·CVE-2024-26308 → 1.26.0에서 수정
             commons-lang3:    CVE-2025-48924 → 3.18.0에서 수정 -->
        <commons-compress.version>1.27.1</commons-compress.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <jjwt.version>0.12.6</jjwt.version>
        <mybatis.version>3.0.4</mybatis.version>
        <springdoc.version>2.7.0</springdoc.version>
        <lombok.version>1.18.42</lombok.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <dotenv.version>5.1.0</dotenv.version>
    </properties>

    <!-- Spring AI 1.1.6은 Maven Central 정식 배포 (Milestone 저장소 불필요)
         단, 향후 1.2.x Milestone·2.x 검토 시 Milestone 저장소 추가:
           <repositories>
             <repository>
               <id>spring-milestones</id>
               <url>https://repo.spring.io/milestone</url>
               <snapshots><enabled>false</enabled></snapshots>
             </repository>
           </repositories>
    -->

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI 1.1.6 BOM (Stable) -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ===== 이행적 종속성 CVE 대응 =====
                 testcontainers(:test)가 끌어오는 commons-* 취약 버전을
                 안전 버전으로 강제. 실제 위험은 test scope로 프로덕션 미포함이나
                 정적분석 경고 제거·심사 대응 목적으로 override. -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>${commons-compress.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- ===== Spring Boot 기본 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <!-- WebClient 사용 (LLM·ORS·공공데이터 비동기 호출) -->
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===== 보안 (Spring Security + JWT) ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- .env 파일을 Spring 프로퍼티 소스로 읽는다.
             Spring Boot는 .env를 표준으로 인식하지 않아, 셸에서 export하지 않으면
             ${GOOGLE_API_KEY:} 같은 참조가 빈 값이 된다.
             이 의존성이 있으면 팀원 전원이 별도 환경변수 설정 없이 .env만으로 실행할 수 있다.
             (Spring Boot 3 전용 아티팩트. MIT) -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>springboot3-dotenv</artifactId>
            <version>${dotenv.version}</version>
        </dependency>

        <!-- ===== DB (PostgreSQL + PostGIS + pgvector) =====
             접근 전략 (ADR-002 옵션 Y, MyBatis 8 : JdbcClient 2):
               - 단순 CRUD: MyBatis (Mapper XML)
               - PostGIS/pgvector 연산자: JdbcClient + Raw SQL
               - 벡터 검색: Spring AI VectorStore (RAG 전담)
        -->

        <!-- JdbcClient + DataSource + HikariCP (PostGIS·pgvector raw SQL용) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- MyBatis Spring Boot Starter (단순 CRUD 도메인용) -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis.version}</version>
        </dependency>

        <!-- PostgreSQL JDBC 드라이버 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- PostGIS JDBC (GEOMETRY 컬럼 매핑) -->
        <dependency>
            <groupId>net.postgis</groupId>
            <artifactId>postgis-jdbc</artifactId>
            <version>${postgis-jdbc.version}</version>
        </dependency>

        <!-- JTS Topology Suite -->
        <dependency>
            <groupId>org.locationtech.jts</groupId>
            <artifactId>jts-core</artifactId>
            <version>${jts.version}</version>
        </dependency>

        <!-- pgvector JDBC 매핑 -->
        <dependency>
            <groupId>com.pgvector</groupId>
            <artifactId>pgvector</artifactId>
            <version>${pgvector.version}</version>
        </dependency>

        <!-- ===== DB 마이그레이션 (Flyway) =====
             도입 이유: schema.sql만 고치고 기존 DB에 반영하지 않아 두 번 사고가 났다.
                        (line_geom MultiLineString / facility_type AIR_PUMP — 후자는 6일 잠복)
                        3인이 각자 로컬 DB를 굴리는데 반영 여부를 추적할 수단이 없었다.
                        앱 기동 시 자동 적용되므로 사람이 실행하는 단계가 사라진다.

             테스트도 같은 마이그레이션을 탄다. 이전에는 테스트만 schema.sql로 새로 만들고
             개발 DB는 손으로 고쳐서, 테스트는 통과하고 개발만 깨지는 상태였다.

             ⚠️ Flyway 10부터 DB별 지원이 별도 아티팩트로 분리됐다.
                flyway-database-postgresql이 없으면 기동 시 "Unsupported Database" 로 실패한다.
                버전은 Spring Boot BOM이 관리한다. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ===== AI (Spring AI 1.1.6 Stable) =====
             채택: spring-ai-starter-model-google-genai
               - 1.x에 정상 존재 (Maven Central 배포)
               - Gemini Developer API (개발) + Vertex AI (운영) 모두 지원
               - application.yml 프로파일만 교체하면 두 환경 모두 동작

             개발 환경 (application-local.yml):
               spring.ai.google.genai.api-key: ${GOOGLE_API_KEY}
             운영 환경 (application-prod.yml):
               spring.ai.google.genai.vertex.project-id: ${GCP_PROJECT_ID}

             대안 (1.x Google Gen AI에 이슈 발견 시):
               spring-ai-starter-model-vertex-ai-gemini (1.x에서 정상)
        -->

        <!-- LLM 채팅 + Structured Output (Gemini Developer API ↔ Vertex AI 전환 가능)

             commons-logging 제외 이유:
               Spring은 spring-jcl을 내장한다. commons-logging과 패키지·클래스명이
               (org.apache.commons.logging.LogFactory) 같으면서 실제로는 SLF4J로 넘겨,
               Logback 설정 하나로 전부 통제되게 하는 대체 구현이다.

               진짜 commons-logging.jar가 함께 있으면 같은 이름의 클래스가 둘이 되고
               어느 쪽이 로드될지는 클래스패스 순서에 달린다. 진짜 쪽이 이기면 그걸 쓰는
               라이브러리 로그가 Logback을 우회해 로그 레벨 설정이 먹지 않는다.

               경로는 하나다 (dependency:tree 확인):
                 spring-ai-starter-model-google-genai
                   -> spring-ai-google-genai -> google-genai
                   -> httpcomponents:httpclient 4.5.14 -> commons-logging 1.2
               Boot 스타터는 이걸 자동 제외하지만 Spring AI 스타터는 하지 않는다.

               빼도 httpclient는 정상 동작한다. JCL API를 부르면 spring-jcl이 응답한다. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-google-genai</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 임베딩 (text-embedding-004, 768차원) 배포 단계에서 활성화-->
        <!--
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-vertex-ai-embedding</artifactId>
        </dependency>
        -->

        <!-- pgvector Vector Store (RAG 검색) 4주차 RAG 착수 시점에 gemini-embedding-001을 어느 스타터로 호출할지(google-genai embedding vs vertex embedding) 재결정-->
        <!--
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>
        -->

        <!-- ===== 유틸 ===== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <version>${mapstruct.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ===== API 문서 (Swagger UI) ===== -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ===== 테스트 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot Maven Plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Java 컴파일러 (Java 25 + Lombok·MapStruct 어노테이션 프로세서) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>