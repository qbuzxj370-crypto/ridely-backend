<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.ridely.dao.SavedRouteDao">

    <!--
        조회 세 곳(단건·목록)이 같은 컬럼을 쓴다.
        컬럼명 → 필드명 변환은 map-underscore-to-camel-case 설정이 처리한다.

        recommended_route를 조인하는 이유는 목록에 코스 이름만 있으면 무슨 코스인지 알 수 없어서다.
        경로 좌표(route_geom)는 넣지 않는다. 목록 한 페이지가 수천 좌표를 실어 나르게 된다.
        상세 화면이 형상을 그릴 때는 recommendedRouteId로 GET /routes/{id}를 부른다.
    -->
    <sql id="selectColumns">
        sr.saved_route_id,
        sr.recommended_route_id,
        sr.custom_name,
        sr.memo,
        sr.is_favorite,
        sr.created_at,
        rr.ai_title,
        rr.total_distance_km,
        rr.estimated_duration_min,
        rr.intensity_level
    </sql>

    <!--
        저장. recommended_route가 없으면 FK 위반, 같은 코스를 두 번 저장하면 UNIQUE 위반이 난다.
        둘 다 미리 SELECT로 확인하지 않고 DB 제약에 맡긴다.
        확인과 INSERT 사이에 다른 요청이 끼어들면 확인이 무의미해지고, 결국 예외 처리는 어차피 필요하다.

        is_favorite은 넣지 않는다. 저장하는 순간부터 즐겨찾기인 경우는 없고, 컬럼 기본값이 FALSE다.
        켜려면 저장 후 PATCH를 부른다.

        &lt;insert&gt;가 아니라 &lt;select&gt;인 이유는 생성된 번호를 반환값으로 받기 위해서다.
        MyBatis의 &lt;insert&gt;는 반환값이 항상 갱신 행 수라, useGeneratedKeys로 받은 키를
        파라미터 객체에 써 넣는 방법밖에 없다. 그러려면 요청 DTO에 savedRouteId 필드를
        만들어야 하는데, 클라이언트가 보내지도 않는 값을 요청 DTO에 두는 것은 맞지 않다.
        PostgreSQL의 RETURNING이 이 문제를 그대로 푼다.
    -->
    <select id="insertReturningId" resultType="long">
        INSERT INTO saved_route (user_id, recommended_route_id, custom_name, memo)
        VALUES (#{userId},
                #{request.recommendedRouteId},
                #{request.customName},
                #{request.memo})
        RETURNING saved_route_id
    </select>

    <!--
        단건 조회. WHERE에 user_id가 함께 들어가 남의 기록은 애초에 걸리지 않는다.
        없는 것인지 남의 것인지 구분해야 하면 호출부가 existsById를 함께 본다.
    -->
    <select id="selectById" resultType="kr.ridely.dto.savedRoute.SavedRouteResponseDTO">
        SELECT <include refid="selectColumns"/>
          FROM saved_route sr
          JOIN recommended_route rr ON rr.recommended_route_id = sr.recommended_route_id
         WHERE sr.saved_route_id = #{savedRouteId}
           AND sr.user_id = #{userId}
    </select>

    <!--
        목록 조회.

        정렬은 화이트리스트다. 파라미터를 ${}로 SQL에 직접 넣으면 주입 통로가 되므로
        허용한 값만 &lt;choose&gt;로 분기하고 나머지는 latest로 떨어뜨린다.

        name 정렬에 COALESCE를 쓰는 이유는 custom_name이 선택 항목이라서다.
        안 붙였으면 화면이 ai_title을 보여 주므로 정렬도 화면에 보이는 값을 따라야 한다.
        그냥 custom_name으로 정렬하면 이름 없는 항목이 전부 한쪽에 몰린다.

        created_at을 두 번째 키로 두는 이유는 이름이 같은 항목의 순서를 고정하기 위해서다.
        정렬이 흔들리면 페이지를 넘길 때 같은 항목이 두 번 나오거나 건너뛴다.
    -->
    <select id="selectByUserId" resultType="kr.ridely.dto.savedRoute.SavedRouteResponseDTO">
        SELECT <include refid="selectColumns"/>
          FROM saved_route sr
          JOIN recommended_route rr ON rr.recommended_route_id = sr.recommended_route_id
        <include refid="listWhere"/>
        <choose>
            <when test="sort == 'name'">
                ORDER BY COALESCE(sr.custom_name, rr.ai_title) ASC, sr.created_at DESC
            </when>
            <otherwise>
                ORDER BY sr.created_at DESC
            </otherwise>
        </choose>
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!-- 전체 건수. 목록과 조건이 어긋나면 페이지 수가 맞지 않으므로 WHERE를 공유한다 -->
    <select id="countByUserId" resultType="long">
        SELECT COUNT(*)
          FROM saved_route sr
        <include refid="listWhere"/>
    </select>

    <sql id="listWhere">
        <where>
            sr.user_id = #{userId}
            <if test="favoriteOnly != null and favoriteOnly">
                AND sr.is_favorite = TRUE
            </if>
        </where>
    </sql>

    <!--
        부분 수정 (PATCH). UserSettingsMapper.updateSettings와 같은 방식이다.
        null 검사를 하는 이유는 요청에 없던 필드(null)를 그대로 UPDATE하면 기존 값이 지워지기 때문이다.

        메모를 지우고 싶으면 빈 문자열을 보낸다. null은 "안 보냈다"라는 뜻이라 지우기와 구분되지 않는다.

        saved_route에는 updated_at이 없어 갱신 시각을 남기지 않는다. 스키마 v1.1 그대로다.
        그래서 UserSettingsMapper와 달리 항상 붙는 항목이 없고, 셋 다 null이면 &lt;set&gt;이 비어
        UPDATE saved_route WHERE ... 라는 깨진 SQL이 만들어진다.
        서비스가 빈 요청을 먼저 걸러내므로 여기까지 오지 않는다.
    -->
    <update id="update">
        UPDATE saved_route
        <set>
            <if test="request.customName != null">custom_name = #{request.customName},</if>
            <if test="request.memo != null">memo = #{request.memo},</if>
            <if test="request.isFavorite != null">is_favorite = #{request.isFavorite},</if>
        </set>
        WHERE saved_route_id = #{savedRouteId}
          AND user_id = #{userId}
    </update>

    <delete id="delete">
        DELETE FROM saved_route
         WHERE saved_route_id = #{savedRouteId}
           AND user_id = #{userId}
    </delete>

    <!-- 소유자를 보지 않는다. 404와 403을 구분하는 용도라 남의 것도 true여야 한다 -->
    <select id="existsById" resultType="boolean">
        SELECT EXISTS (SELECT 1 FROM saved_route WHERE saved_route_id = #{savedRouteId})
    </select>

</mapper>
