<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.ridely.dao.UserDao">

    <!-- 회원 정보 조회 (컬럼명 → 필드명 변환은 map-underscore-to-camel-case 설정이 처리) -->
    <select id="selectById" resultType="kr.ridely.vo.AppUser">
        SELECT user_id, login_id, password_hash, nickname, email,
               status, last_login_at, created_at, updated_at
          FROM app_user
         WHERE user_id = #{userId}
    </select>

    <!--
        회원 정보 부분 수정 (PATCH).

        &lt;set&gt;은 조건에 맞는 항목만 골라 SET 절을 만들고,
        마지막에 남는 쉼표를 알아서 떼어 준다.
        예) 닉네임만 보내면 → SET nickname = ?, updated_at = NOW()

        null 검사를 하는 이유: PATCH는 "보낸 항목만 수정"이므로
        요청에 없던 필드(null)를 그대로 UPDATE하면 기존 값이 지워진다.
    -->
    <update id="updateProfile">
        UPDATE app_user
        <set>
            <if test="request.nickname != null">nickname = #{request.nickname},</if>
            <if test="request.email != null">email = #{request.email},</if>
            updated_at = NOW()
        </set>
        WHERE user_id = #{userId}
    </update>

    <!-- 비밀번호 변경. 해시는 서비스가 만들어 넘긴다 -->
    <update id="updatePassword">
        UPDATE app_user
           SET password_hash = #{passwordHash},
               updated_at    = NOW()
         WHERE user_id = #{userId}
    </update>

    <!--
        회원 탈퇴 (하드 삭제).

        행을 지운다. 나머지는 FK가 처리한다.
          refresh_token · user_settings · saved_route · riding_session
          · riding_history_embedding   → ON DELETE CASCADE
          recommended_route            → ON DELETE SET NULL (코스는 공용 자산이라 남긴다)

        소프트 삭제(status = 'WITHDRAWN')였던 것을 바꿨다. 이력을 남기려던 것인데
        그 이력이 GPS 궤적이라 탈퇴 뒤 보관할 법적 근거가 없다.
        개인정보보호법 제21조는 불필요해진 개인정보를 지체 없이 파기하라고 한다.
    -->
    <delete id="withdraw">
        DELETE FROM app_user
         WHERE user_id = #{userId}
    </delete>

</mapper>
