# Terraform — state 파일에 db_password 등이 평문으로 남는다 (Secrets Manager 미사용 결정, iam.tf 참조).
# .terraform.lock.hcl은 반대로 커밋 대상 (프로바이더 버전 고정) — 여기서 제외하지 않는다.
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
infra/terraform/*.tfplan

# 로컬 DB 크리덴셜 포함 — 커밋 금지 (.env로 관리)
src/main/resources/application-local.yml

# ===== 기획·설계 문서 (로컬 전용) =====
# docs/ 내용은 기본적으로 커밋하지 않는다.
# ※ 'docs/'가 아니라 'docs/*'로 적어야 한다.
#   디렉터리 자체를 제외하면 git이 내부를 탐색하지 않아 !예외가 동작하지 않는다.
docs/*

# 팀과 공유하는 문서만 예외 (프론트 연동 가이드 등)
!docs/shared/

# docs/private/ — 디버깅 세션 로그 등 팀과 공유하지 않는 개인 작업 기록.
# docs/*에 이미 걸리지만, 의도를 분명히 하려고 명시적으로 한 번 더 적어둔다.
docs/private/

# GCP 서비스 계정 키 (Vertex AI 전환 시 사용 — JSON 키 파일)
*-service-account*.json
gcp-key*.json
credentials*.json

