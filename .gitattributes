# 저장소 내 텍스트 파일은 LF로 통일 (OS 혼용 시 CRLF 잡음 diff 방지)
# text=auto : 텍스트/바이너리 자동 판별
# eol=lf    : 체크아웃 시에도 LF 유지 (Windows에서도 LF)
* text=auto eol=lf

# Windows 전용 스크립트는 CRLF 유지 (LF면 실행 불가)
*.cmd text eol=crlf
*.bat text eol=crlf

# Unix 실행 스크립트는 LF 고정
/mvnw text eol=lf
*.sh text eol=lf

# 바이너리 — 줄바꿈 변환 금지
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.pdf binary
