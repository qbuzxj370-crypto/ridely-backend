<?xml version='1.0' encoding='utf-8'?>
<widget id="kr.ridely.app" version="1.1.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Ridely</name>
    <description>
        흩어진 자전거 인프라를 활용해 라이딩을 키우는 AI 트레이너
    </description>
    <author email="dev@ridely.kr" href="https://ridely.kr">
        Ridely Team
    </author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="*" />
    <icon src="res/icon.png" />
    <splash src="res/splash.png" />
    <preference name="SplashScreenDelay" value="1500" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="SplashShowOnlyFirstTime" value="false" />
    <!-- 새 로고(주황 자전거 아이콘, 배경 #FDFDFD)로 바꾸며 배경색도 맞췄다.
         기존 #FF1E7B6C(청록)는 이전 텍스트 로고용 브랜드 컬러라 새 로고와 안 맞았다. -->
    <preference name="SplashScreenBackgroundColor" value="#FFFDFDFD" />
    <!-- Android 12+는 위의 <splash> 태그를 더 이상 안 본다(cordova-android 경고: deprecated).
         대신 이 preference로 지정해야 시스템 스플래시(SplashScreen API)에 코르도바 기본 로고 대신
         실제 앱 아이콘이 뜬다. -->
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/icon.png" />
    <preference name="AndroidWindowSplashScreenBackground" value="#FFFDFDFD" />
    <platform name="android">
        <!-- Adaptive icon(전경/배경 분리) — 이게 없으면 런처가 마스크를 못 씌워서
             완전히 네모난 아이콘으로만 뜬다(2026-09-20, 실기기 확인). 전경은 로고만
             투명 배경으로 뺀 것, 배경은 스플래시와 맞춘 단색(#FDFDFD).
             기존 <icon src="res/icon.png"/>는 이 설정을 못 읽는 구형 기기용 대체 아이콘으로 남긴다. -->
        <icon density="mdpi" background="res/icon-background.png" foreground="res/icon-foreground.png" />
        <!-- 백엔드가 로컬 개발 중 https가 아닌 http(localhost)라서 평문 통신을 허용한다.
             경쟁작 MVP 범위라 지금은 전체 허용, 배포 임박 시 도메인 단위로 좁힌다. -->
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application" xmlns:android="http://schemas.android.com/apk/res/android">
            <application android:usesCleartextTraffic="true" />
        </edit-config>
    </platform>
</widget>
