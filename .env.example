SPRING_PROFILES_ACTIVE=local

DB_URL=jdbc:postgresql://localhost:5432/ridely
DB_USER=
DB_PASSWORD=

JWT_SECRET=실제로_openssl_rand_base64_32_명령으로_생성한_값

GCP_PROJECT_ID=
GCP_LOCATION=
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=gcp-credentials.json 경로

ORS_API_KEY=실제_ORS_토큰
KAKAO_REST_API_KEY=실제_Kakao_REST_키
KAKAO_JS_API_KEY=실제_Kakao_JS_키
TAAS_SERVICE_KEY=실제_공공데이터_인증키
SEOUL_OPEN_API_KEY=실제_서울_인증키
TOUR_API_KEY=공공데이터_포탈_인증키

# ===== prod (EC2) 전용 — 로컬 개발에는 불필요 =====
# CloudFront 배포 후 나온 기본 도메인. 여러 개면 콤마 구분.
CORS_ALLOWED_ORIGINS=https://실제_배포된_cloudfront_도메인.cloudfront.net
# Bedrock 리전/모델. 기본값(application-prod.yml)을 안 바꿀 거면 비워 둬도 됨.
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
# AWS 액세스키는 여기 없음 — EC2 인스턴스 역할(IAM)로 무인증 처리.

# ===== LLM 게이트웨이 (LiteLLM, OpenAI 호환) =====
# 2026-09-29에 Bedrock 직접 권한이 회수된다. 그 뒤 운영은 LLM_PROVIDER=openai로 둔다.
# 공급자: google-genai(로컬 기본) | bedrock-converse(prod 기본) | openai(게이트웨이)
LLM_PROVIDER=
# 관리자에게 받은 게이트웨이 주소. /v1은 붙이지 않는다.
OPENAI_BASE_URL=
# 관리자가 DM으로 준 키(sk-...). 분실하면 복구 불가 — 절대 커밋·채팅 공유 금지.
OPENAI_API_KEY=
# bedrock-haiku | bedrock-sonnet | bedrock-gpt-5.6-luna
OPENAI_MODEL=bedrock-sonnet